{
  "pluginAlias": "UnifiFirewall",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "unifi": {
        "type": "object",
        "title": "Unifi Controller Settings",
        "properties": {
          "url": {
            "title": "Controller URL",
            "type": "string",
            "required": true
          },
          "username": {
            "title": "Username",
            "type": "string",
            "required": true
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": true
          },
          "site": {
            "title": "Site ID",
            "type": "string",
            "default": "default",
            "required": true
          },
          "strictSSL": {
            "title": "Validate the SSL Certificate?",
            "type": "boolean",
            "required": true,
            "default": false
          }
        }
      },
      "includeRuleIndexes": {
        "type": "array",
        "title": "Include Rule Indexes",
        "description": "Optional list of firewall rule indexes to expose. When omitted, all rules are eligible unless explicitly excluded or hidden.",
        "items": {
          "type": "string"
        }
      },
      "excludeRuleIndexes": {
        "type": "array",
        "title": "Exclude Rule Indexes",
        "description": "Firewall rule indexes to ignore (even if they would otherwise be included).",
        "items": {
          "type": "string"
        }
      },
      "hiddenRuleIndexes": {
        "type": "array",
        "title": "Hidden Rule Indexes",
        "description": "Firewall rule indexes to hide from Homebridge while keeping them available for discovery summaries.",
        "items": {
          "type": "string"
        }
      },
      "customNames": {
        "type": "object",
        "title": "Custom Rule Names",
        "description": "Map of firewall rule index to the name that should be displayed in Homebridge. Defaults to the controller rule name.",
        "additionalProperties": {
          "type": "string"
        }
      },
      "rules": {
        "type": "array",
        "items": {
          "title": "Firewall Rules",
          "type": "object",
          "properties": {
            "id": {
              "title": "Rule Index (typically 4 digit number)",
              "type": "string",
              "required": true
            },
            "name": {
              "title": "Name",
              "placeholder": "Name to give the switch in Homebridge",
              "type": "string",
              "required": true
            },
            "inverted": {
              "type": "boolean",
              "title": "Invert switch behaviour",
              "required": true,
              "default": false
            }
          }
        }
      }
    }
  }
}
